# 账本数据源（必填，仅 serve/migrate 时校验；create_server 零配置可启动）
ERP_LEDGER_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/erp_ledger
# 本 cell 绑定的租户（查询闸），默认 default
ERP_TENANT_ID=default
# 本位币，默认 CNY
ERP_BASE_CURRENCY=CNY
# BYOK 凭证：外部系统凭证只经环境变量注入，零落库零日志。
# 命名 ERP_BYOK_<NAME>，例如 api 源用 credential_name=payment 时：
# ERP_BYOK_PAYMENT=xxxxxxxx
